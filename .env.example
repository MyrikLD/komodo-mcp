KOMODO_MCP_KOMODO_URL=https://komodo.example.com
KOMODO_MCP_KOMODO_API_KEY=your-api-key
KOMODO_MCP_KOMODO_API_SECRET=your-api-secret
KOMODO_MCP_HOST=0.0.0.0
KOMODO_MCP_PORT=8000
# OAuth 2.1 (optional — all three required to enable)
# KOMODO_MCP_OAUTH_JWT_SECRET=random-string-32-chars-or-more
# KOMODO_MCP_OAUTH_PASSWORD=login-page-password
# KOMODO_MCP_BASE_URL=https://mcp.example.com
# Where the revoked-token list is kept (mount as a volume in Docker)
# KOMODO_MCP_STATE_DIR=/data
